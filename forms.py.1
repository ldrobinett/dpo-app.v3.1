        # if team and (self.obj is None or self.obj.id != team.id):
        if team:
             # Basic check, adjust if edit needs to allow saving same name
             instance = getattr(self, '_obj', None)
             if instance and instance.id == team.id:
                 pass # Allow saving same name if editing the same object
