{% extends "base.html" %}
{% block content %}
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a href="{{ url_for('home') }}" class="list-group-item list-group-item-action active">Home</a>
                <a href="{{ url_for('dashboard') }}" class="list-group-item list-group-item-action">Financial Dashboard</a>
                <a href="{{ url_for('schedules') }}" class="list-group-item list-group-item-action">Schedules</a>
                <a href="{{ url_for('work_logs') }}" class="list-group-item list-group-item-action">Work Logs</a>
                <a href="{{ url_for('teams') }}" class="list-group-item list-group-item-action">Teams</a>
            </div>
            {% if current_user.is_authenticated %}
                <a href="{{ url_for('logout') }}" class="list-group-item list-group-item-action mt-3">Logout</a>
            {% endif %}
        </div>
        
        <div class="col-md-9">
            <h1>Welcome to the Daily Performance Dashboard</h1>
            <p>Use the links on the left to navigate the application or view key metrics below.</p>
            
            ---

            <h2 class="mt-4">This Week's Financial Forecast 📈</h2>
            {% if weekly_financial_total %}
                <div class="card my-4">
                    <div class="card-body">
                        <p class="card-text"><strong>Expected Flat Rate Hours (FRH):</strong> {{ "%.2f"|format(weekly_financial_total.expected_frh) }}</p>
                        <p class="card-text"><strong>Effective Labor Rate (ELR):</strong> ${{ "%.2f"|format(weekly_financial_total.elr) }}</p>
                        <p class="card-text"><strong>Labor Gross:</strong> ${{ "%.2f"|format(weekly_financial_total.labor_gross) }}</p>
                        <p class="card-text"><strong>Parts Gross:</strong> ${{ "%.2f"|format(weekly_financial_total.parts_gross) }}</p>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning" role="alert">
                    No financial data available for this week. Please set your financial inputs on the <a href="{{ url_for('dashboard') }}">Financial Dashboard</a>.
                </div>
            {% endif %}

            ---

            <h2 class="mt-4">Team Schedules 👥</h2>
            {% if tech_schedules %}
                {% for team_name, members in tech_schedules.items() %}
                    <div class="card my-4">
                        <div class="card-header bg-primary text-white">
                            {{ team_name }}
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                {% for member in members %}
                                    <li class="list-group-item">{{ member.name }} - {{ member.schedule }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="alert alert-info" role="alert">
                    No team schedule data available.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}