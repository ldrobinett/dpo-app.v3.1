@app.route("/schedules", methods=['GET', 'POST'])
@login_required
def schedules():
    form = ScheduleEntryFilterForm()
    query = ScheduleEntry.query
    
    if form.validate_on_submit():
        if form.team_member.data:
            query = query.filter_by(team_member_id=form.team_member.data.id)
            
    schedule_entries = query.order_by(ScheduleEntry.date.desc()).all()
    return render_template('schedules.html', title='Schedules', entries=schedule_entries, form=form)

