# 01.prodapp.0825/app.py

from flask import Flask, render_template, url_for, flash, redirect, request
from extensions import db, login_manager, bcrypt
from models import User, Team, TeamMember, ScheduleEntry, WorkLog, TeamSchedule
from forms import (
    RegistrationForm, LoginForm, TeamForm, TeamMemberForm, ScheduleEntryForm,
    WorkLogForm, TeamScheduleForm, RecurringScheduleForm, ScheduleEntryFilterForm, FinancialPerformanceForm
)
from flask_login import login_user, current_user, logout_user, login_required
from datetime import date, time, timedelta
import calendar
from collections import defaultdict

def create_app():
    app = Flask(__name__)
    app.config['SECRET_KEY'] = 'a_very_secret_key'
    app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///site.db'
    
    db.init_app(app)
    login_manager.init_app(app)
    login_manager.login_view = 'login'

    @login_manager.user_loader
    def load_user(user_id):
        return User.query.get(int(user_id))
    
    return app

app = create_app()

@app.route("/")
@app.route("/home")
@login_required
def home():
    recent_schedule_entries = ScheduleEntry.query.order_by(ScheduleEntry.date.desc()).limit(5).all()
    recent_work_logs = WorkLog.query.order_by(WorkLog.date.desc()).limit(5).all()
    return render_template('home.html', 
                           title='Home',
                           recent_schedule_entries=recent_schedule_entries,
                           recent_work_logs=recent_work_logs)

@app.route("/dashboard", methods=['GET', 'POST'])
@login_required
def dashboard():
    today = date.today()
    start_of_week = today - timedelta(days=today.weekday())
    end_of_week = start_of_week + timedelta(days=6)
    start_of_next_week = start_of_week + timedelta(days=7)
    end_of_next_week = start_of_next_week + timedelta(days=6)
    start_of_month = today.replace(day=1)

    financial_form = FinancialPerformanceForm()

    financial_data = None
    weekly_financial_total = None
    next_weekly_financial_total = None
    full_month_financial_forecast = None
    
    if request.method == 'POST' and financial_form.validate_on_submit():
        elr = financial_form.elr.data
        parts_to_labor_ratio = financial_form.parts_to_labor_ratio.data
        labor_margin = financial_form.labor_margin.data / 100
        parts_margin = financial_form.parts_margin.data / 100

        all_schedules_in_range = ScheduleEntry.query.filter(
            ScheduleEntry.date >= start_of_week,
            ScheduleEntry.date <= end_of_next_week
        ).all()
        
        financial_data = defaultdict(lambda: {'labor_gross': 0, 'parts_gross': 0, 'total_gross': 0, 'expected_frh': 0})
        for s in all_schedules_in_range:
            expected_frh_day = s.team_member.daily_production_objective
            labor_gross = expected_frh_day * elr * labor_margin
            parts_gross = expected_frh_day * elr * parts_to_labor_ratio * parts_margin
            total_gross = labor_gross + parts_gross
            
            financial_data[s.date]['labor_gross'] += labor_gross
            financial_data[s.date]['parts_gross'] += parts_gross
            financial_data[s.date]['total_gross'] += total_gross
            financial_data[s.date]['expected_frh'] += expected_frh_day

        weekly_financial_total = defaultdict(float)
        next_weekly_financial_total = defaultdict(float)

        for d, data in financial_data.items():
            if start_of_week <= d <= end_of_week:
                weekly_financial_total['labor_gross'] += data['labor_gross']
                weekly_financial_total['parts_gross'] += data['parts_gross']
                weekly_financial_total['total_gross'] += data['total_gross']
                weekly_financial_total['expected_frh'] += data['expected_frh']
            
            if start_of_next_week <= d <= end_of_next_week:
                next_weekly_financial_total['labor_gross'] += data['labor_gross']
                next_weekly_financial_total['parts_gross'] += data['parts_gross']
                next_weekly_financial_total['total_gross'] += data['total_gross']
                next_weekly_financial_total['expected_frh'] += data['expected_frh']
        
        full_month_schedules = ScheduleEntry.query.filter(
            ScheduleEntry.date >= start_of_month,
            ScheduleEntry.date <= date.fromordinal(start_of_month.toordinal() + calendar.monthrange(today.year, today.month)[1] - 1)
        ).all()
        
        total_month_frh = sum(s.team_member.daily_production_objective for s in full_month_schedules)
        
        full_month_financial_forecast = {
            'expected_frh': total_month_frh,
            'labor_gross': total_month_frh * elr * labor_margin,
            'parts_gross': total_month_frh * elr * parts_to_labor_ratio * parts_margin,
        }
        full_month_financial_forecast['total_gross'] = full_month_financial_forecast['labor_gross'] + full_month_financial_forecast['parts_gross']

        flash('Financials calculated successfully!', 'success')
    
    # --- This entire block is now outside the POST condition ---
    weekly_member_data = {}
    mtd_member_data = {}
    expected_frh_mtd = 0

    for member in TeamMember.query.all():
        weekly_scheduled_hours = 0
        weekly_logged_hours = 0
        weekly_actual_work_hours = 0
        weekly_expected_production = 0
        
        weekly_schedules = ScheduleEntry.query.filter(
            ScheduleEntry.team_member_id == member.id,
            ScheduleEntry.date >= start_of_week,
            ScheduleEntry.date <= today
        ).all()
        
        weekly_work_logs = WorkLog.query.filter(
            WorkLog.team_member_id == member.id,
            WorkLog.date >= start_of_week,
            WorkLog.date <= today
        ).all()
        
        for s in weekly_schedules:
            scheduled_time = datetime.combine(s.date, s.end_time) - datetime.combine(s.date, s.start_time)
            scheduled_hours_net = scheduled_time.total_seconds() / 3600
            if s.lunch_start and s.lunch_end:
                lunch_time = datetime.combine(s.date, s.lunch_end) - datetime.combine(s.date, s.lunch_start)
                scheduled_hours_net -= lunch_time.total_seconds() / 3600
            weekly_scheduled_hours += scheduled_hours_net
            weekly_expected_production += member.daily_production_objective
                
        for log in weekly_work_logs:
            if log.flat_rate_hours:
                weekly_logged_hours += log.flat_rate_hours
            actual_time = datetime.combine(log.date, log.end_time) - datetime.combine(log.date, log.start_time)
            weekly_actual_work_hours += actual_time.total_seconds() / 3600

        weekly_member_data[member.name] = {
            'scheduled': weekly_scheduled_hours,
            'actual_worked': weekly_actual_work_hours,
            'logged_frh': weekly_logged_hours,
            'production_objective': weekly_expected_production
        }

        mtd_scheduled_hours = 0
        mtd_logged_hours = 0
        mtd_actual_work_hours = 0
        mtd_expected_production = 0

        mtd_schedules = ScheduleEntry.query.filter(
            ScheduleEntry.team_member_id == member.id,
            ScheduleEntry.date >= start_of_month,
            ScheduleEntry.date <= today
        ).all()
        
        mtd_work_logs = WorkLog.query.filter(
            WorkLog.team_member_id == member.id,
            WorkLog.date >= start_of_month,
            WorkLog.date <= today
        ).all()

        for s in mtd_schedules:
            scheduled_time = datetime.combine(s.date, s.end_time) - datetime.combine(s.date, s.start_time)
            scheduled_hours_net = scheduled_time.total_seconds() / 3600
            if s.lunch_start and s.lunch_end:
                lunch_time = datetime.combine(s.date, s.lunch_end) - datetime.combine(s.date, s.lunch_start)
                scheduled_hours_net -= lunch_time.total_seconds() / 3600
            mtd_scheduled_hours += scheduled_hours_net
            mtd_expected_production += member.daily_production_objective

        for log in mtd_work_logs:
            if log.flat_rate_hours:
                mtd_logged_hours += log.flat_rate_hours
            actual_time = datetime.combine(log.date, log.end_time) - datetime.combine(log.date, log.start_time)
            mtd_actual_work_hours += actual_time.total_seconds() / 3600

        mtd_member_data[member.name] = {
            'scheduled': mtd_scheduled_hours,
            'actual_worked': mtd_actual_work_hours,
            'logged_frh': mtd_logged_hours,
            'production_objective': mtd_expected_production
        }
    
    expected_frh_mtd = sum(s.team_member.daily_production_objective for s in ScheduleEntry.query.filter(ScheduleEntry.date >= start_of_month, ScheduleEntry.date <= today).all())

    return render_template('dashboard.html',
                           title='Dashboard',
                           weekly_member_data=weekly_member_data,
                           mtd_member_data=mtd_member_data,
                           financial_form=financial_form,
                           expected_frh_mtd=expected_frh_mtd,
                           financial_data=financial_data,
                           weekly_financial_total=weekly_financial_total,
                           next_weekly_financial_total=next_weekly_financial_total,
                           full_month_financial_forecast=full_month_financial_forecast,
                           current_week_dates=f"{start_of_week.strftime('%b %d')} - {end_of_week.strftime('%b %d')}",
                           next_week_dates=f"{start_of_next_week.strftime('%b %d')} - {end_of_next_week.strftime('%b %d')}")

@app.route("/register", methods=['GET', 'POST'])
def register():
    if current_user.is_authenticated:
        return redirect(url_for('home'))
    form = RegistrationForm()
    if form.validate_on_submit():
        hashed_password = bcrypt.generate_password_hash(form.password.data).decode('utf-8')
        user = User(username=form.username.data, password=hashed_password)
        db.session.add(user)
        db.session.commit()
        flash('Your account has been created! You are now able to log in', 'success')
        return redirect(url_for('login'))
    return render_template('register.html', title='Register', form=form)

@app.route("/login", methods=['GET', 'POST'])
def login():
    if current_user.is_authenticated:
        return redirect(url_for('home'))
    form = LoginForm()
    if form.validate_on_submit():
        user = User.query.filter_by(username=form.username.data).first()
        if user and bcrypt.check_password_hash(user.password, form.password.data):
            login_user(user, remember=form.remember.data)
            next_page = request.args.get('next')
            return redirect(next_page) if next_page else redirect(url_for('home'))
        else:
            flash('Login Unsuccessful. Please check username and password', 'danger')
    return render_template('login.html', title='Login', form=form)

@app.route("/logout")
def logout():
    logout_user()
    return redirect(url_for('login'))

